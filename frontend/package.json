{
  "name": "nexawork-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "format": "prettier --write src tests *.json *.ts index.html",
    "format:check": "prettier --check src tests *.json *.ts index.html"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
