APP_NAME=NexaWork
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexawork
DB_USER=postgres
DB_PASSWORD=change-me

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000
# Development only; set real hostnames in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

PASSWORD_RESET_URL=http://localhost:3000/reset-password

RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Files stay disabled until a private persistent root and scanner are configured.
ATTACHMENTS_ENABLED=false
STORAGE_LOCAL_ROOT=./var/private-attachments
PERSISTENT_LOCAL_STORAGE=false
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_MESSAGE=10
ATTACHMENT_MAX_DRAFTS=20
ATTACHMENT_ORG_DAILY_BYTES=1073741824
ATTACHMENT_UPLOAD_TIMEOUT=120
FILE_SCAN_HOST=
FILE_SCAN_PORT=3310
FILE_SCAN_TIMEOUT=30
# Development/test only; always rejected outside those environments.
ALLOW_UNSCANNED_DEVELOPMENT_FILES=false
MESSAGING_RATE_LIMITS_ENABLED=false
